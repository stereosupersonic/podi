= simple_form_for([ :admin, user ], html: { class: "form-horizontal" }) do |f|
  = f.error_notification
  .form-inputs
    = f.input :first_name
    = f.input :last_name
    = f.input :email, required: true
    = f.input :password, required: user.new_record?, input_html: { autocomplete: "new-password" },
                         hint: ("Leave blank to keep the password" if user.persisted?)
    = f.input :password_confirmation, required: user.new_record?, input_html: { autocomplete: "new-password" }
    = f.input :admin unless user == current_user
  .form-actions
    = submit_button
